{
  "$defs": {
    "Backing": {
      "description": "Who holds a register's value. Ordered weakest first so a policy floor is a\nplain comparison: `seen >= required`.",
      "enum": [
        "virtualized",
        "kernel-service",
        "privileged-service",
        "hardware"
      ],
      "type": "string"
    },
    "Base64Url": {
      "contentEncoding": "base64url",
      "description": "bytes, base64url without padding (RFC 4648 section 5), canonical trailing bits",
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048]|[A-Za-z0-9_-][AQgw])?$",
      "type": "string"
    },
    "Base64UrlBytes16": {
      "contentEncoding": "base64url",
      "description": "exactly 16 bytes, base64url without padding",
      "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$",
      "type": "string"
    },
    "Base64UrlBytes32": {
      "contentEncoding": "base64url",
      "description": "exactly 32 bytes, base64url without padding",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
      "type": "string"
    },
    "Base64UrlBytes48": {
      "contentEncoding": "base64url",
      "description": "exactly 48 bytes, base64url without padding",
      "pattern": "^[A-Za-z0-9_-]{64}$",
      "type": "string"
    },
    "Base64UrlBytes64": {
      "contentEncoding": "base64url",
      "description": "exactly 64 bytes, base64url without padding",
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$",
      "type": "string"
    },
    "CommitmentPolicy": {
      "additionalProperties": false,
      "description": "The pinned commitment parameters (section 8.1).",
      "properties": {
        "header16": {
          "$ref": "#/$defs/Base64UrlBytes16",
          "const": "QVRTLU1SLTEBARAAAAAAAA",
          "default": "QVRTLU1SLTEBARAAAAAAAA"
        },
        "seed": {
          "$ref": "#/$defs/Base64UrlBytes48",
          "const": "YM3K6sPxWpbLKhuF1CxaTRKfztZUNQRMklD9_--YmEzDvUIJcsOvWCleD2G6IeSn",
          "default": "YM3K6sPxWpbLKhuF1CxaTRKfztZUNQRMklD9_--YmEzDvUIJcsOvWCleD2G6IeSn"
        }
      },
      "type": "object"
    },
    "Digest": {
      "description": "`{alg, value}` with the value the length of the algorithm's digest.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "alg": {
              "const": "sha256"
            },
            "value": {
              "$ref": "#/$defs/Base64UrlBytes32"
            }
          },
          "required": [
            "alg",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "alg": {
              "const": "sha384"
            },
            "value": {
              "$ref": "#/$defs/Base64UrlBytes48"
            }
          },
          "required": [
            "alg",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "alg": {
              "const": "sha512"
            },
            "value": {
              "$ref": "#/$defs/Base64UrlBytes64"
            }
          },
          "required": [
            "alg",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "FreshnessPolicy": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/KeyBinding",
          "description": "When set, the evidence must bind exactly this key."
        }
      },
      "type": "object"
    },
    "GpuArch": {
      "description": "NVIDIA device architecture as NRAS names it.",
      "enum": [
        "HOPPER",
        "BLACKWELL",
        "LS10"
      ],
      "type": "string"
    },
    "GpuDevicePolicy": {
      "additionalProperties": false,
      "description": "Per-device gates evaluated against each NRAS submodule; defaults fail closed.",
      "properties": {
        "allow_debug": {
          "default": false,
          "type": "boolean"
        },
        "require_measres_success": {
          "default": true,
          "type": "boolean"
        },
        "require_nonce_match": {
          "default": true,
          "type": "boolean"
        },
        "require_secboot": {
          "default": true,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "GpuPolicy": {
      "additionalProperties": false,
      "description": "NVIDIA device policy (section 13.5, `gpu`). Defined without a feature gate so\nthe policy schema is one schema; the `nvidia-gpu` verifier converts it to\nits own parameter types.",
      "properties": {
        "device_policy": {
          "$ref": "#/$defs/GpuDevicePolicy",
          "default": {
            "allow_debug": false,
            "require_measres_success": true,
            "require_nonce_match": true,
            "require_secboot": true
          }
        },
        "expected_archs": {
          "description": "Accepted architectures, as NRAS names them (`HOPPER`, `BLACKWELL`, `LS10`).",
          "items": {
            "$ref": "#/$defs/GpuArch"
          },
          "minItems": 1,
          "type": "array"
        },
        "required": {
          "default": false,
          "description": "Reject envelopes without a device submodule.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "IdentityPolicy": {
      "additionalProperties": false,
      "description": "Machine allowlist (section 13.3). An identity absent from `machines` fails.",
      "properties": {
        "machines": {
          "items": {
            "$ref": "#/$defs/MachineEntry"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "machines"
      ],
      "type": "object"
    },
    "KeyBinding": {
      "description": "`cvm_binding.key` (section 5.3): an SPKI or TBSCertificate digest, or raw bytes.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "spki-sha256"
            },
            "value": {
              "$ref": "#/$defs/Base64UrlBytes32"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "x509-tbs-sha256"
            },
            "value": {
              "$ref": "#/$defs/Base64UrlBytes32"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "raw"
            },
            "value": {
              "allOf": [
                {
                  "$ref": "#/$defs/Base64Url"
                }
              ],
              "maxLength": 87380
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "MachineEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Base64Url",
          "description": "The `cvm_identity` value: SNP `chip_id`, TDX `ppid`, CCA `instance_id`,\nor a GPU `ueid` as UTF-8. 1 to 128 bytes: 2 to 171 base64url characters.",
          "maxLength": 171,
          "minLength": 2
        },
        "tcb_floor": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "OwnerPolicy": {
      "additionalProperties": false,
      "properties": {
        "id_key_digests": {
          "description": "SNP `id_key_digest` values that make `cvm_owner` trustworthy.",
          "items": {
            "$ref": "#/$defs/Base64UrlBytes48"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "id_key_digests"
      ],
      "type": "object"
    },
    "PolicyBitsPolicy": {
      "additionalProperties": false,
      "properties": {
        "allow_debug": {
          "default": false,
          "type": "boolean"
        },
        "allow_migration": {
          "default": false,
          "type": "boolean"
        },
        "allow_service_td": {
          "default": false,
          "type": "boolean"
        },
        "require_sept_ve_disable": {
          "default": true,
          "type": "boolean"
        },
        "require_vmpl0": {
          "default": true,
          "type": "boolean"
        },
        "require_zero_reserved_attributes": {
          "default": true,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "ReferenceValues": {
      "additionalProperties": false,
      "description": "Reference values, from confos manifests (flat JSON or CoRIM).",
      "properties": {
        "host_data": {
          "$ref": "#/$defs/Base64Url",
          "description": "The value `cvm_host_data` must carry, zero-padded to the platform's\nlength (32 bytes on SNP, 48 on TDX): the Kata initdata gate.",
          "maxLength": 64,
          "minLength": 2
        },
        "launch_measurement": {
          "default": [],
          "description": "Any of these launch measurements is acceptable. Empty means unpinned.",
          "items": {
            "$ref": "#/$defs/Digest"
          },
          "type": "array"
        },
        "pcrs": {
          "additionalProperties": false,
          "default": {},
          "description": "Acceptable values per vTPM PCR, for the `vtpm` submodule; a PCR absent\nhere is not pinned. Azure's initdata convention pins PCR 8 to\n`SHA-256(zeros32 || initdata_hash)`.",
          "patternProperties": {
            "^([0-9]|1[0-9]|2[0-3])$": {
              "items": {
                "$ref": "#/$defs/Digest"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "type": "object"
        },
        "registers": {
          "additionalProperties": false,
          "default": {},
          "description": "Acceptable values per slot. A slot absent here is not pinned.",
          "patternProperties": {
            "^(0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$": {
              "items": {
                "$ref": "#/$defs/Digest"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "type": "object"
        },
        "slot_owners": {
          "additionalProperties": false,
          "default": {},
          "description": "Required `owner` of a workload slot's claim record (section 8.3).",
          "patternProperties": {
            "^(0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "SnpFloor": {
      "additionalProperties": false,
      "description": "An SEV-SNP floor: `min` bounds each report TCB value named in `values`.",
      "properties": {
        "min": {
          "$ref": "#/$defs/SnpTcb"
        },
        "values": {
          "default": [
            "reported",
            "current",
            "committed",
            "launch"
          ],
          "description": "The TCB values held to `min`; all four when omitted.",
          "items": {
            "$ref": "#/$defs/SnpTcbValue"
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "min"
      ],
      "type": "object"
    },
    "SnpTcb": {
      "additionalProperties": false,
      "description": "SNP TCB version components (used for KDS URL construction and TCB checks).",
      "properties": {
        "bootloader": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "fmc": {
          "description": "FMC (Firmware Microcontroller) SPL, present only on Turin processors.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "microcode": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "snp": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "tee": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "bootloader",
        "tee",
        "snp",
        "microcode"
      ],
      "type": "object"
    },
    "SnpTcbValue": {
      "description": "The four TCB values an SEV-SNP report carries.",
      "oneOf": [
        {
          "const": "reported",
          "description": "The TCB the VCEK that signed the report was derived for.",
          "type": "string"
        },
        {
          "const": "current",
          "description": "The TCB of the firmware running when the report was signed.",
          "type": "string"
        },
        {
          "const": "committed",
          "description": "The anti-rollback floor: SNP_COMMIT refuses firmware below it.",
          "type": "string"
        },
        {
          "const": "launch",
          "description": "The current TCB when the guest was launched or imported.",
          "type": "string"
        }
      ]
    },
    "TcbFloor": {
      "additionalProperties": false,
      "description": "A named floor constrains at least one platform (section 13.2).",
      "minProperties": 1,
      "properties": {
        "snp": {
          "$ref": "#/$defs/SnpFloor"
        },
        "tdx": {
          "$ref": "#/$defs/TdxFloor"
        }
      },
      "type": "object"
    },
    "TcbPolicy": {
      "additionalProperties": false,
      "properties": {
        "default_floor": {
          "type": "string"
        },
        "floors": {
          "additionalProperties": {
            "$ref": "#/$defs/TcbFloor"
          },
          "default": {},
          "description": "Named floors; a machine entry or `default_floor` selects one.",
          "type": "object"
        },
        "require_revocation": {
          "default": true,
          "type": "boolean"
        },
        "require_signed_collateral": {
          "default": true,
          "type": "boolean"
        },
        "tdx_allowed_status": {
          "default": [
            "UpToDate"
          ],
          "items": {
            "enum": [
              "UpToDate",
              "SWHardeningNeeded",
              "ConfigurationNeeded",
              "ConfigurationAndSWHardeningNeeded",
              "OutOfDate",
              "OutOfDateConfigurationNeeded"
            ],
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "type": "object"
    },
    "TdxFloor": {
      "additionalProperties": false,
      "description": "A TDX floor names at least one bound.",
      "minProperties": 1,
      "properties": {
        "min_tcb_evaluation_data_number": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "min_tee_tcb_svn": {
          "$ref": "#/$defs/Base64UrlBytes16"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://confidential.ai/schemas/cvm-policy-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "commitment": {
      "$ref": "#/$defs/CommitmentPolicy",
      "default": {
        "header16": "QVRTLU1SLTEBARAAAAAAAA",
        "seed": "YM3K6sPxWpbLKhuF1CxaTRKfztZUNQRMklD9_--YmEzDvUIJcsOvWCleD2G6IeSn"
      }
    },
    "freshness": {
      "$ref": "#/$defs/FreshnessPolicy",
      "default": {}
    },
    "gpu": {
      "$ref": "#/$defs/GpuPolicy",
      "default": {
        "device_policy": {
          "allow_debug": false,
          "require_measres_success": true,
          "require_nonce_match": true,
          "require_secboot": true
        },
        "required": false
      }
    },
    "identity": {
      "$ref": "#/$defs/IdentityPolicy"
    },
    "min_backing": {
      "$ref": "#/$defs/Backing",
      "default": "hardware",
      "description": "The weakest backing any verified register may have."
    },
    "owner": {
      "$ref": "#/$defs/OwnerPolicy"
    },
    "policy_bits": {
      "$ref": "#/$defs/PolicyBitsPolicy",
      "default": {
        "allow_debug": false,
        "allow_migration": false,
        "allow_service_td": false,
        "require_sept_ve_disable": true,
        "require_vmpl0": true,
        "require_zero_reserved_attributes": true
      }
    },
    "reference": {
      "$ref": "#/$defs/ReferenceValues",
      "default": {
        "launch_measurement": [],
        "pcrs": {},
        "registers": {},
        "slot_owners": {}
      }
    },
    "tcb": {
      "$ref": "#/$defs/TcbPolicy",
      "default": {
        "floors": {},
        "require_revocation": true,
        "require_signed_collateral": true,
        "tdx_allowed_status": [
          "UpToDate"
        ]
      }
    }
  },
  "title": "CVM attestation profile v1: verifier policy",
  "type": "object"
}
